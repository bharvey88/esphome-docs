&lt;/span>&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="w"> &lt;/span>&lt;span class="nt">event_types&lt;/span>&lt;span class="p">:&lt;/span>&lt;span class="w">
